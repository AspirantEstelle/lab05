<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:focusableInTouchMode="true">

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/title"
            android:textSize="28sp" android:textStyle="bold" android:textColor="#172446" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:layout_marginBottom="32dp"
            android:text="@string/subtitle" android:textSize="15sp" android:textColor="#58657C" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:labelFor="@id/firstNumber" android:text="@string/first_number" android:textSize="16sp" />
        <EditText
            android:id="@+id/firstNumber"
            android:layout_width="match_parent" android:layout_height="64dp"
            android:hint="@string/number_hint" android:inputType="numberDecimal|numberSigned"
            android:maxLength="20" android:singleLine="true" android:textSize="24sp" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:labelFor="@id/secondNumber"
            android:text="@string/second_number" android:textSize="16sp" />
        <EditText
            android:id="@+id/secondNumber"
            android:layout_width="match_parent" android:layout_height="64dp"
            android:hint="@string/number_hint" android:inputType="numberDecimal|numberSigned"
            android:maxLength="20" android:singleLine="true" android:textSize="24sp" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:orientation="horizontal">
            <Button android:id="@+id/addButton" style="@style/OperationButton"
                android:text="@string/add" android:contentDescription="@string/add_description" />
            <Button android:id="@+id/subtractButton" style="@style/OperationButton"
                android:text="@string/subtract" android:contentDescription="@string/subtract_description" />
            <Button android:id="@+id/multiplyButton" style="@style/OperationButton"
                android:text="@string/multiply" android:contentDescription="@string/multiply_description" />
            <Button android:id="@+id/divideButton" style="@style/OperationButton"
                android:text="@string/divide" android:contentDescription="@string/divide_description" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:padding="24dp"
            android:background="@drawable/result_background" android:orientation="vertical">
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/result_label" android:textColor="#3154CD" android:textSize="15sp" />
            <TextView
                android:id="@+id/resultText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/result_empty"
                android:textSize="24sp" android:textColor="#172446"
                android:accessibilityLiveRegion="polite" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="32dp" android:text="@string/footer"
            android:textColor="#58657C" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
